<h1>Search TMDb</h1>

<%= form_tag search_tmdb_path, method: :get, id: 'tmdb_form' do %>
  <div class="form-group">
    <%= label_tag :search_terms, "Movie Title" %>
    <%= text_field_tag :search_terms, params[:search_terms], class: "form-control" %>
  </div>
  <div class="form-group">
    <%= label_tag :release_year, "Release Year" %>
    <%= text_field_tag :release_year, params[:release_year], class: "form-control" %>
  </div>
  <div class="form-group">
    <%= label_tag :language, "Language" %>
    <%= text_field_tag :language, params[:language] || 'en', class: "form-control" %>
  </div>
  <%= submit_tag "Search", class: "btn btn-primary" %>
  <%= link_to "Home", root_path, class: "btn btn-secondary" %>
<% end %>

<% flash.each do |key, value| %>
  <div class="alert alert-<%= key %> alert-dismissible fade show" role="alert">
    <%= value %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<% if @movies.present? %>
  <table class="table" id="search_movies">
    <thead>
      <tr>
        <th>Title</th>
        <th>Release Date</th>
        <th>Rating</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% @movies.each do |movie| %>
        <tr>
          <td><%= movie.title %></td>
          <td><%= movie.release_date %></td>
          <td><%= movie.rating %></td>
          <td>
            <%= form_tag add_movie_movies_path, method: :post do %>
              <%= hidden_field_tag :title, movie.title %>
              <%= hidden_field_tag :release_date, movie.release_date %>
              <%= hidden_field_tag :rating, movie.rating %>
              <%= submit_tag "Add Movie", class: "btn btn-success" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
